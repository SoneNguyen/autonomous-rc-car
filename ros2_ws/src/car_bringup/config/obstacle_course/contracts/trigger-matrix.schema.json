{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trigger-matrix.schema.json",
  "title": "Obstacle course component trigger and attribution matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "components", "behaviors", "roles", "rows"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matrix_id": {"type": "string", "minLength": 1},
    "components": {"const": ["lidar", "camera", "imu", "odometry", "contact"]},
    "behaviors": {"const": ["FOLLOW_ROUTE", "CAUTION", "AVOID_LEFT", "AVOID_RIGHT", "STOP", "RESUME"]},
    "roles": {"const": ["trigger", "support", "veto", "overruled"]},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "behavior", "role", "rule"],
      "properties": {
        "component": {"enum": ["lidar", "camera", "imu", "odometry", "contact"]},
        "behavior": {"enum": ["FOLLOW_ROUTE", "CAUTION", "AVOID_LEFT", "AVOID_RIGHT", "STOP", "RESUME"]},
        "role": {"enum": ["trigger", "support", "veto", "overruled"]},
        "rule": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"component": {"const": "camera"}, "behavior": {"enum": ["AVOID_LEFT", "AVOID_RIGHT", "STOP"]}}, "required": ["component", "behavior"]},
          "then": {"properties": {"role": {"not": {"const": "trigger"}}}}
        }
      ]
    }
  }
}
