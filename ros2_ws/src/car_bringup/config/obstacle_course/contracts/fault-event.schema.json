{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fault-event.schema.json",
  "title": "Obstacle course scenario fault event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "run_id", "run_purpose", "scenario_id", "event_type",
    "seed", "sim_time_ns", "component", "entity_id", "route_progress_m",
    "obstacle_range_m", "config_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "run_purpose": {"enum": ["demonstration", "development", "diagnostic"]},
    "scenario_id": {"enum": ["S0", "S1", "S2", "S3", "S3b", "S4", "S5", "S6-lidar-drop", "S6-camera-drop", "S7", "barrier_tuning"]},
    "event_type": {"enum": ["sensor_dropout_started", "sensor_dropout_ended", "obstacle_revealed"]},
    "seed": {"type": "integer", "minimum": 0},
    "sim_time_ns": {"type": "integer", "minimum": 0},
    "component": {"type": ["string", "null"], "enum": ["lidar", "camera", null]},
    "entity_id": {"type": ["string", "null"]},
    "route_progress_m": {"type": ["number", "null"], "minimum": 0},
    "obstacle_range_m": {"type": ["number", "null"], "minimum": 0},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frozen_inputs_root_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"run_purpose": {"const": "demonstration"}}, "required": ["run_purpose"]},
      "then": {"required": ["frozen_inputs_root_sha256"]}
    },
    {
      "if": {"properties": {"event_type": {"const": "obstacle_revealed"}}, "required": ["event_type"]},
      "then": {"properties": {"component": {"const": null}, "entity_id": {"type": "string"}, "route_progress_m": {"type": "number"}, "obstacle_range_m": {"type": "number"}}}
    },
    {
      "if": {"properties": {"event_type": {"enum": ["sensor_dropout_started", "sensor_dropout_ended"]}}, "required": ["event_type"]},
      "then": {"properties": {"component": {"enum": ["lidar", "camera"]}}}
    }
  ]
}
