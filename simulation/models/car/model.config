<?xml version="1.0"?>
<model>
  <name>gazebo_truck</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>gz-ws</name>
  </author>
  <description>
    A four-wheel Gazebo model extracted from chassis.blend. Visual meshes are
    split into a chassis and four hub-local wheels; collision geometry is kept
    simple so the model is practical to simulate.
  </description>
</model>
