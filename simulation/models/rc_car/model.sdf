      <child>wheel_rl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>40</effort>
          <velocity>100</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="wheel_rr_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_rr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>40</effort>
          <velocity>100</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.2</kingpin_width>
      <steering_limit>0.50414051869</steering_limit>
      <wheel_base>0.27</wheel_base>
      <wheel_separation>0.2</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <min_velocity>-1</min_velocity>
      <max_velocity>1</max_velocity>
      <min_acceleration>-0.4</min_acceleration>
      <max_acceleration>0.5</max_acceleration>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
