          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="wheel_fr">
      <pose>0.135 -0.1 -0.0345 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.036</mass>
        <inertia>
          <ixx>1.1676e-05</ixx>
          <iyy>1.9602e-05</iyy>
          <izz>1.1676e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
