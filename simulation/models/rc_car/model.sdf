          <izz>5e-08</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="wheel_fl">
      <pose>0.135 0.1 -0.0345 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.036</mass>
        <inertia>
          <ixx>1.1676e-05</ixx>
          <iyy>1.9602e-05</iyy>
          <izz>1.1676e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.033</radius>
