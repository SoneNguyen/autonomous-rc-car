<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="gazebo_truck">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <inertial>
        <pose>0 0 -0.005 0 0 0</pose>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.002085</ixx>
          <iyy>0.0056859375</iyy>
          <izz>0.00723</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.38 0.22 0.085</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <sensor name="bumper_contact" type="contact">
        <pose>0 0 0 0 0 0</pose>
        <frame_id>base_link</frame_id>
        <topic>/model/gazebo_truck/sensors/bumper_contact</topic>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <contact>
          <collision>chassis_collision</collision>
        </contact>
      </sensor>
      <sensor name="front_camera" type="camera">
        <pose>0.1 0 0.1 0 0 0</pose>
        <frame_id>camera_link</frame_id>
        <topic>/model/gazebo_truck/sensors/front_camera/image</topic>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.2217304764</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>12</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="front_camera_segmentation" type="segmentation">
        <pose>0.1 0 0.1 0 0 0</pose>
        <frame_id>camera_link</frame_id>
        <topic>/model/gazebo_truck/sensors/front_camera_segmentation</topic>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <segmentation_type>instance</segmentation_type>
          <horizontal_fov>1.2217304764</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>12</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.11 0 0.055 0 0 0</pose>
        <frame_id>lidar_link</frame_id>
        <topic>/model/gazebo_truck/sensors/front_lidar/scan</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>361</samples>
              <resolution>1</resolution>
              <min_angle>-1.57079632679</min_angle>
              <max_angle>1.57079632679</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>8</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>0 0 0.02 0 0 0</pose>
        <frame_id>imu_link</frame_id>
        <topic>/model/gazebo_truck/sensors/imu</topic>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <link name="front_left_steering">
      <pose>0.135 0.1 -0.0345 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.003</mass>
        <inertia>
          <ixx>5e-08</ixx>
          <iyy>5e-08</iyy>
          <izz>5e-08</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
