    </link>
    <link name="wheel_rr">
      <pose>-0.135 -0.1 -0.0345 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.036</mass>
        <inertia>
          <ixx>1.1676e-05</ixx>
          <iyy>1.9602e-05</iyy>
          <izz>1.1676e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.50414051869</lower>
          <upper>0.50414051869</upper>
          <effort>40</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.50414051869</lower>
          <upper>0.50414051869</upper>
          <effort>40</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="wheel_fl_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>wheel_fl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>40</effort>
          <velocity>100</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="wheel_fr_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>wheel_fr</child>
      <axis>
