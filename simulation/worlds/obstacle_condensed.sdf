<?xml version="1.0"?>
<sdf version="1.10">
  <world name="obstacle_course">
    <physics name="rc_course_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.52 0.70 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 6</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 6</size></plane></geometry>
          <material><ambient>0.18 0.34 0.16 1</ambient><diffuse>0.18 0.34 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="course_road">
      <static>true</static>
      <link name="road_link">
        <visual name="asphalt">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>28 1.45 0.012</size></box></geometry>
          <material>
            <pbr><metal><albedo_map>model://research/floors/floor_asphalt_001/Asphalt001_1K-JPG_Color.jpg</albedo_map><normal_map>model://research/floors/floor_asphalt_001/Asphalt001_1K-JPG_NormalGL.jpg</normal_map><roughness_map>model://research/floors/floor_asphalt_001/Asphalt001_1K-JPG_Roughness.jpg</roughness_map><roughness>1.0</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="left_edge">
          <pose>0 0.68 0.014 0 0 0</pose>
          <geometry><box><size>27.8 0.035 0.002</size></box></geometry>
          <material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material>
        </visual>
        <visual name="right_edge">
          <pose>0 -0.68 0.014 0 0 0</pose>
          <geometry><box><size>27.8 0.035 0.002</size></box></geometry>
          <material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material>
        </visual>
        <visual name="center_dash_0"><pose>0.5 0 0.014 0 0 0</pose><geometry><box><size>0.30 0.025 0.002</size></box></geometry><material><ambient>0.95 0.78 0.08 1</ambient><diffuse>0.95 0.78 0.08 1</diffuse></material></visual>
