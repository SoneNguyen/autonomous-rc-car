<?xml version="1.0"?>
<sdf version="1.10">
  <model name="obstacle_template">
    <static>true</static>
    <link name="obstacle_link">
      <visual name="original_research_barrier">
        <!-- This GLB is a multi-object, Y-up asset. Select its red barrier,
             center it, rotate it upright, and scale it to the contact proxy. -->
        <pose>0 0 0.06655 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://research/obstacle/road_barrier_set/road-barrier-set.glb</uri>
            <scale>0.5511 0.16036 0.48156</scale>
            <submesh>
              <name>Water-filled barrier (red)</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="barrier_contact">
        <pose>0 0 0.06655 0 0 0</pose>
        <geometry><box><size>0.5511 0.2167 0.1331</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
