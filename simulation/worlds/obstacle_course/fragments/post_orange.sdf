<?xml version="1.0"?>
<sdf version="1.10">
  <model name="obstacle_template">
    <static>true</static>
    <link name="obstacle_link">
      <visual name="research_high_detail_reflector_cone">
        <!-- The locked research mesh is Y-up and twice the course reference scale;
             rotate Y into Gazebo Z and lift its 0.14 m visual by half-height. -->
        <pose>0 0 0.07 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://research/cone/cone_reflector_01/cone_reflector_01.glb</uri>
            <scale>0.0534 0.0534 0.0534</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="cone_contact">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry><cylinder><radius>0.0534</radius><length>0.14</length></cylinder></geometry>
      </collision>
    </link>
  </model>
</sdf>
