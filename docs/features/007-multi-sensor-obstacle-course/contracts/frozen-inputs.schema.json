{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frozen-inputs.schema.json",
  "title": "Feature 007 frozen demonstration input manifest",
  "$comment": "Compute root_sha256 as SHA-256 over UTF-8 lines `path<TAB>sha256<LF>` for inputs sorted by normalized relative path. The manifest itself and generated outputs are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_utc", "inputs", "root_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "created_utc": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "root_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
