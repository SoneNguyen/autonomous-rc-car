{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Feature 007 obstacle-course scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "seed", "run_purpose", "world_path", "lighting_profile", "vehicle_preset", "entry_speed_mps", "start_pose", "route", "obstacles", "expected_behavior_sequence", "expected_trigger_components", "contact_rule", "setup_sheet"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"enum": ["S0", "S1", "S2", "S3", "S3b", "S4", "S5", "S6-lidar-drop", "S6-camera-drop", "S7"]},
    "seed": {"type": "integer", "minimum": 1},
    "run_purpose": {"enum": ["demonstration", "development", "diagnostic"]},
    "world_path": {"type": "string", "pattern": "^simulation/worlds/[^/]+\\.sdf$"},
    "lighting_profile": {"const": "world_default"},
    "vehicle_preset": {"const": "rc_vehicle_reference"},
    "entry_speed_mps": {"$ref": "#/$defs/measurement"},
    "start_pose": {"$ref": "#/$defs/pose"},
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["frame", "waypoints", "length_m", "sizing"],
      "properties": {
        "frame": {"const": "vehicle_relative"},
        "waypoints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/pose"}},
        "length_m": {"$ref": "#/$defs/measurement"},
        "sizing": {
          "type": "object", "additionalProperties": false,
          "required": ["entry_speed_mps", "approach_distance_m", "lateral_shift_m", "recovery_distance_m"],
          "properties": {
            "entry_speed_mps": {"$ref": "#/$defs/measurement"},
            "approach_distance_m": {"$ref": "#/$defs/measurement"},
            "lateral_shift_m": {"$ref": "#/$defs/measurement"},
            "recovery_distance_m": {"$ref": "#/$defs/measurement"}
          }
        }
      }
    },
    "obstacles": {"type": "array", "items": {"$ref": "#/$defs/obstacle"}},
    "fault_injections": {"type": "array", "items": {"$ref": "#/$defs/fault"}},
    "expected_behavior_sequence": {"type": "array", "minItems": 1, "items": {"enum": ["FOLLOW_ROUTE", "CAUTION", "AVOID_LEFT", "AVOID_RIGHT", "STOP", "RESUME"]}},
    "expected_trigger_components": {"type": "array", "uniqueItems": true, "items": {"enum": ["lidar", "camera", "imu", "odometry", "contact"]}},
    "contact_rule": {"enum": ["no_non_ground_contact", "contact_expected_and_latched"]},
    "setup_sheet": {"type": "string", "minLength": 1},
    "run_timeout_s": {"$ref": "#/$defs/sim_time"},
    "condition_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"contact_rule": {"const": "contact_expected_and_latched"}}, "required": ["contact_rule"]},
      "then": {"properties": {"expected_trigger_components": {"contains": {"const": "contact"}}}}
    },
    {
      "if": {"properties": {"contact_rule": {"const": "no_non_ground_contact"}}, "required": ["contact_rule"]},
      "then": {"properties": {"expected_trigger_components": {"not": {"contains": {"const": "contact"}}}}}
    },
    {
      "if": {"properties": {"scenario_id": {"const": "S5"}}, "required": ["scenario_id"]},
      "then": {"required": ["fault_injections"], "properties": {"fault_injections": {"contains": {"properties": {"action": {"const": "reveal_obstacle"}}, "required": ["action"]}}}}
    },
    {
      "if": {"properties": {"scenario_id": {"enum": ["S0", "S1", "S2", "S3", "S3b", "S4", "S6-lidar-drop", "S6-camera-drop", "S7"]}}, "required": ["scenario_id"]},
      "then": {"properties": {"contact_rule": {"const": "no_non_ground_contact"}}}
    }
  ],
  "$defs": {
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "provenance", "status"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "status": {"enum": ["scaled", "measured", "measured_sim", "placeholder", "derived", "requirement"]}
      }
    },
    "pose": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "yaw"],
      "properties": {"x": {"$ref": "#/$defs/measurement"}, "y": {"$ref": "#/$defs/measurement"}, "yaw": {"$ref": "#/$defs/measurement"}}
    },
    "obstacle": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "class", "colour", "pose", "dimensions_m", "mesh_or_fragment", "scan_plane_intersection"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["barrier", "post", "gate", "generic_object"]},
        "colour": {"type": "string", "minLength": 1},
        "pose": {"$ref": "#/$defs/pose"},
        "initial_pose": {"$ref": "#/$defs/pose"},
        "dimensions_m": {
          "type": "object", "additionalProperties": false,
          "required": ["length", "width", "height"],
          "properties": {"length": {"$ref": "#/$defs/measurement"}, "width": {"$ref": "#/$defs/measurement"}, "height": {"$ref": "#/$defs/measurement"}}
        },
        "mesh_or_fragment": {"type": "string", "minLength": 1},
        "scan_plane_intersection": {"type": "boolean"}
      }
    },
    "fault": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "start_sim_time", "end_sim_time", "action"],
      "properties": {
        "component": {"type": ["string", "null"], "enum": ["lidar", "camera", null]},
        "start_sim_time": {"$ref": "#/$defs/sim_time"},
        "end_sim_time": {"$ref": "#/$defs/sim_time"},
        "action": {"enum": ["drop", "reveal_obstacle"]},
        "entity_id": {"type": "string", "minLength": 1},
        "trigger_pose_progress_m": {"$ref": "#/$defs/distance"}
      },
      "allOf": [
        {"if": {"properties": {"action": {"const": "reveal_obstacle"}}, "required": ["action"]}, "then": {"required": ["entity_id", "trigger_pose_progress_m"], "properties": {"component": {"const": null}}}},
        {"if": {"properties": {"action": {"const": "drop"}}, "required": ["action"]}, "then": {"properties": {"component": {"enum": ["lidar", "camera"]}}}}
      ]
    },
    "sim_time": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "provenance", "status"],
      "properties": {"value": {"type": "number", "minimum": 0}, "unit": {"const": "s"}, "provenance": {"type": "string", "minLength": 1}, "status": {"enum": ["scaled", "measured", "measured_sim", "placeholder", "derived", "requirement"]}}
    },
    "distance": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "provenance", "status"],
      "properties": {"value": {"type": "number", "minimum": 0}, "unit": {"const": "m"}, "provenance": {"type": "string", "minLength": 1}, "status": {"enum": ["scaled", "measured", "measured_sim", "placeholder", "derived", "requirement"]}}
    }
  }
}
