{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stop-reasons.json",
  "title": "RC sensor and actuation matrix stop reasons",
  "description": "Closed set of primary stop reasons recorded by the sensor and actuation matrix.",
  "type": "string",
  "enum": [
    "launch_rejected",
    "simulation_paused",
    "bridge_unavailable",
    "sensor_stale",
    "sim_time_mismatch",
    "controller_not_ready",
    "command_path_unavailable",
    "command_authority_conflict",
    "motion_not_observed",
    "detection_path_unavailable",
    "contact_unavailable",
    "tf_unresolved",
    "observation_unavailable",
    "safety_watchdog_stop",
    "intentional_zero_command",
    "unclassified_stop"
  ]
}
